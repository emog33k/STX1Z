# параллельные аккаунты
CONCURRENCY=2
# убивать процессы Riot Client при старте
CLOSE_CLIENTS_AT_START=true
# пауза между спавнами (сек)
SPAWN_STAGGER_S=3.0
# пауза между сообщениями (сек)
MESSAGE_DELAY_S=1.2

# версия SDK и client_id
SDK_VERSION=25.7.1.6086
CLIENT_ID=riot-client

# путь до RiotClientServices.exe
RIOT_SERVICES_EXE=C:\Riot Games\Riot Client\RiotClientServices.exe

# отправлять ли сообщения друзьям
SEND_MESSAGES=true
# текст сообщения
MESSAGE_TEXT=meow
# линия патча LoL
PATCHLINE=live

# прокси обязательны (true/false)
PROXY_REQUIRED=false
# режим выдачи прокси: random или roundrobin
PROXY_MODE=random
# таймаут HTTP-запросов (сек)
HTTP_TIMEOUT=30
# URL для быстрой проверки прокси
GOOGLE_PROBE_URL=https://www.google.com/generate_204

# уровни логов
LOG_LEVEL_CONSOLE=INFO
LOG_LEVEL_FILE=DEBUG

# сервис решения hCaptcha
HC_API_URL=https://asskicker.xyz/SolveHcaptcha
# ключ к сервису
HC_API_KEY=YOUR_SECRET_KEY
# общий таймаут решения (сек)
HC_TIMEOUT_S=120
# число попыток опроса статуса
HC_RETRY_MAX=20
# пауза между опросами (сек)
HC_RETRY_DELAY_S=2.5
